# Database (Neon PostgreSQL)
# - DATABASE_URL: pooled connection (host *-pooler.*) - dipakai runtime aplikasi
# - DIRECT_URL: direct connection (host tanpa -pooler) - dipakai prisma migrate
#   (DDL tidak aman lewat pooled connection). Neon dashboard > Connection string > Direct.
DATABASE_URL="postgresql://YOUR_USER:YOUR_PASSWORD@YOUR_NEON_HOST-pooler.neon.tech/YOUR_DB?sslmode=require"
DIRECT_URL="postgresql://YOUR_USER:YOUR_PASSWORD@YOUR_NEON_HOST.neon.tech/YOUR_DB?sslmode=require"

# NextAuth
NEXTAUTH_SECRET="generate-with: openssl rand -base64 32"
NEXTAUTH_URL="http://localhost:3000"

# Google OAuth (https://console.cloud.google.com/apis/credentials)
# Redirect callback: {NEXTAUTH_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID="..."
GOOGLE_CLIENT_SECRET="..."

# GitHub OAuth (https://github.com/settings/developers)
# Redirect callback: {NEXTAUTH_URL}/api/auth/callback/github
GITHUB_CLIENT_ID="..."
GITHUB_CLIENT_SECRET="..."

# Cloudflare R2 - Image Storage
# Dapatkan dari dashboard Cloudflare R2
R2_ACCOUNT_ID="..."
R2_ACCESS_KEY_ID="..."
R2_SECRET_ACCESS_KEY="..."
R2_BUCKET_NAME="pamerproject"
R2_ENDPOINT="https://<ACCOUNT_ID>.r2.cloudflarestorage.com"
R2_PUBLIC_URL="..."

# Vercel KV - Persistent rate limiting & caching
# Dapatkan dari Vercel Dashboard > Storage > Create KV Database
# Atau jalankan: vercel kv create
KV_REST_API_URL="https://<project-id>.kv.vercel-storage.com"
KV_REST_API_TOKEN="..."
KV_REST_READ_ONLY_KEY="..."

# SMTP — Email server untuk fitur lupa password
# Contoh Gmail: host=smtp.gmail.com, port=587, secure=false
SMTP_HOST="..."
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER="..."
SMTP_PASS="..."
SMTP_FROM_NAME="PamerProject"
SMTP_FROM_EMAIL="support@pamerproject.com"

# Admin Account (untuk seeder)
# Jalankan: npx tsx scripts/seed-admin.ts
ADMIN_NAME="Pamer Project"
ADMIN_USERNAME="pamerproject"
ADMIN_EMAIL="hello@pamerproject.com"
ADMIN_PASSWORD="change-me-please"

# Optional: pin project/post ID agar langsung ter-pin saat seed
# ADMIN_PIN_ID="<prj_id_atau_post_id>"
